theory NBD
begin

/*
 * Symbolic model of NBD's grants, device approvals, and key compromise.
 * See README.md for the adversary, the abstractions, and how each lemma
 * maps to the goals in the top-level README.md.
 *
 * The adversary controls the network and plays every PDS: clients read
 * device records, approvals, deletions, and grants from it. It can
 * compromise any device and create devices of its own. The Spaces host's
 * membership and configuration decisions are trusted, as in the spec.
 *
 * Build the pre-fix variant, where an approval could accept a device while
 * every accepted binding of its account was revoked, with -D=NOLIVEGUARD.
 *
 * Build the inviters proposal (proposal-inviters.md) with -D=INVITERS:
 * issuing a grant then also needs grant standing. Add -D=UNSCOPED for the
 * rejected form in which a vouch gives standing in every space.
 */

builtins: signing, asymmetric-encryption, hashing

// Live-binding counts: z, s(z), s(s(z)), ... (a free function, so cheap to unify).
functions: s/1

/* ---- Devices and compromise ------------------------------------------- */

// A device: independent signing and encryption keys, published as the
// binding <account, pk(sign), pk(enc)>.
rule NewDevice:
    [ Fr(~sk), Fr(~ek) ]
  --[ HonestSign(pk(~sk)), HonestEnc(pk(~ek)), Device($A, pk(~sk), pk(~ek)) ]->
    [ !Dev($A, ~sk, ~ek), Out(<$A, pk(~sk), pk(~ek)>) ]

// Compromise reveals a device's keys.
rule Compromise:
    [ !Dev(A, sk, ek) ]
  --[ Compromised(pk(sk)), CompromisedEnc(pk(ek)) ]->
    [ Out(<sk, ek>) ]

// ... and every space key it holds.
rule LeakHeld:
    [ !Holds(pk(sk), S, k), !Dev(A, sk, ek) ]
  --[ Compromised(pk(sk)), CompromisedEnc(pk(ek)), LeakHeld(S, k) ]->
    [ Out(k) ]

/* ---- Trusted host ----------------------------------------------------- */

// A device creates a space: a fresh key, and a configuration committing to
// it, which the host fixes for the life of the space.
rule CreateSpace:
    [ !Dev(A, sk, ek), Fr(~S), Fr(~kid), Fr(~k) ]
  --[ SpaceKey(~S, ~k), Admitted(~S, A) ]->
    [ !Config(~S, ~kid, h(<~S, ~kid, ~k>)), !Member(~S, A), !Holds(pk(sk), ~S, ~k), Out(<~S, ~kid>) ]

// The host admits accounts by its own decision.
#ifdef INVITERS
// Under INVITERS, an admission also names the account whose invite record
// admitted the account, if any: one with no devices stands for a host
// console or an application without NBD support.
rule Admit:
    [ !Config(S, kid, c) ]
  --[ Admitted(S, $B), AdmittedBy(S, $B, $X) ]->
    [ !Member(S, $B), !AdmittedVia(S, $B, $X) ]
#else
rule Admit:
    [ !Config(S, kid, c) ]
  --[ Admitted(S, $B) ]->
    [ !Member(S, $B) ]
#endif

/* ---- Approvals and key requests (honest devices) ---------------------- */

// Pairing authenticates the target, so honest devices approve only honest
// devices of their own account.
rule Approve:
    let s = <A, pk(sk), pk(ek)>
        t = <A, pk(sk2), pk(ek2)>
    in
    [ !Dev(A, sk, ek), !Dev(A, sk2, ek2) ]
  --[ Neq(sk, sk2), Approved(pk(sk), t) ]->
    [ Out(<'approve', A, s, t, sign(<'approve', A, s, t>, sk)>) ]

// Key requests are signed with the same key under a different tag.
rule KeyRequest:
    let b = <A, pk(sk), pk(ek)> in
    [ !Dev(A, sk, ek), !Config(S, kid, c) ]
  --[ KeyRequested(pk(sk), S) ]->
    [ Out(<'keyreq', S, b, sign(<'keyreq', S, b>, sk)>) ]

/* ---- Client trust: one honest device's view of another account -------- */

// First use: a client that never knew account A accepts what its PDS shows.
// LiveN counts this client's live accepted bindings of A.
rule FirstUse:
    let c = pk(sk)
        t = <A, pt, pet>
    in
    [ !Dev(CA, sk, ek), In(t) ]
  --[ Neq(CA, A), FirstUse(c, A), Knew(c, A), Accept(c, A, t), AcceptFirstUse(c, A, t) ]->
    [ !Acc(c, t), LiveN(c, A, s('z')) ]

// Approval by a binding the client accepted, revoked or not, but only while
// the account has a live accepted binding at this client (D2).
#ifdef INVITERS
// Under INVITERS, the client also records the signer, whose grant standing
// the target inherits.
rule AcceptApproval:
    let s = <A, ps, pes>
        t = <A, pt, pet>
    in
    [ !Acc(c, s), LiveN(c, A, s(n)), In(<'approve', A, s, t, sig>) ]
  --[ Eq(verify(sig, <'approve', A, s, t>, ps), true), Accept(c, A, t), ApprovalAccept(c, A, ps, t) ]->
    [ !Acc(c, t), LiveN(c, A, s(s(n))), !ApprovedBy(c, s, t) ]
#else
rule AcceptApproval:
    let s = <A, ps, pes>
        t = <A, pt, pet>
    in
    [ !Acc(c, s), LiveN(c, A, s(n)), In(<'approve', A, s, t, sig>) ]
  --[ Eq(verify(sig, <'approve', A, s, t>, ps), true), Accept(c, A, t), ApprovalAccept(c, A, ps, t) ]->
    [ !Acc(c, t), LiveN(c, A, s(s(n))) ]
#endif

#ifdef NOLIVEGUARD
// The pre-fix rule: an approval accepts a device even while every accepted
// binding of the account is revoked, ending re-enrollment without a hold.
rule AcceptApprovalDuringReset:
    let s = <A, ps, pes>
        t = <A, pt, pet>
    in
    [ !Acc(c, s), LiveN(c, A, 'z'), In(<'approve', A, s, t, sig>) ]
  --[ Eq(verify(sig, <'approve', A, s, t>, ps), true), Accept(c, A, t), ApprovalAccept(c, A, ps, t), AcceptWhileReset(c, A, t) ]->
    [ !Acc(c, t), LiveN(c, A, s('z')) ]
#endif

// Revocation: the adversary, as PDS, can delete any record for any client.
// Each accepted binding is revoked at most once (a restriction).
rule Revoke:
    let t = <A, pt, pet> in
    [ !Acc(c, t), LiveN(c, A, s(n)), In(<'deleted', t>) ]
  --[ Revoke(c, t) ]->
    [ LiveN(c, A, n) ]

// Re-enrollment: with every accepted binding revoked, a candidate is held.
// The hold consumes the count, so nothing else accepts for A meanwhile.
rule HoldStart:
    let t = <A, pt, pet> in
    [ LiveN(c, A, 'z'), In(t) ]
  --[ HoldStart(c, A, t) ]->
    [ Hold(c, A, t) ]

#ifdef INVITERS
// Under INVITERS, a re-enrolled binding has grant standing in every space.
// (Written with t's shape, which HoldStart fixes, so proofs see its account.)
rule HoldComplete:
    let t = <A, pt, pet> in
    [ Hold(c, A, t) ]
  --[ HoldDone(c, A, t), Accept(c, A, t), AcceptWhileReset(c, A, t), GainStanding(c, 'all', t, t) ]->
    [ !Acc(c, t), LiveN(c, A, s('z')), !Standing(c, 'all', t, t) ]
#else
rule HoldComplete:
    [ Hold(c, A, t) ]
  --[ HoldDone(c, A, t), Accept(c, A, t), AcceptWhileReset(c, A, t) ]->
    [ !Acc(c, t), LiveN(c, A, s('z')) ]
#endif

rule HoldCancel:
    [ Hold(c, A, t), In(<'deleted', t>) ]
  --[ Revoke(c, t) ]->
    [ LiveN(c, A, 'z') ]

/* ---- Grant standing (INVITERS) ---------------------------------------- */

// Grant standing gates only what a client grants; acceptance is unchanged.
// !Standing(c, sc, t, r), with action GainStanding: c may grant to t the key
// of space sc, or of every space if sc is 'all' (spaces are fresh, so none
// is named 'all'). r is the binding the standing came from: t itself, or an
// approval ancestor of t. Own bindings are not modeled: a client never
// accepts its own account's.

#ifdef INVITERS
// An invite: a client learns that its own account's invite admitted
// account A to a space (Admit). It counts only if it admitted A
// (restriction InviteAdmits). A vouch is used only by IssueGrant, which
// checks the inviter's own membership, so this rule need not.
rule Invite:
    let c = pk(sk) in
    [ !Dev(CA, sk, ek), !AdmittedVia(S, A, CA) ]
  --[ Neq(CA, A), Invited(c, S, A) ]->
    [ !Invite(c, S, A) ]
#endif

// The vouch: a client vouches for a binding it accepted by first use when
// its account invited the binding's account, and that invite authorizes the
// binding in the invite's space. That covers both an invite made with the
// first use and a pending invite, made before the client knew the account,
// that the first use captures. The rule lets the vouch come at any time
// after the first use, and the invite before or after it, which only adds
// behaviors; a pending invite's expiry is time, abstracted as holds are: a
// capture may simply never happen.
#ifdef INVITERS & not UNSCOPED
rule InviteFirstUse:
    let t = <A, pt, pet> in
    [ !Acc(c, t), !Invite(c, S, A) ]
  --[ Vouched(c, t), Authorized(c, S, t), GainStanding(c, S, t, t), VouchOnce(c, t), UsesLive(c, t) ]->
    [ !VouchedFor(c, t), !Standing(c, S, t, t) ]
#endif
#ifdef INVITERS & UNSCOPED
// The rejected form: a vouch gives standing in every space.
rule InviteFirstUse:
    let t = <A, pt, pet> in
    [ !Acc(c, t), !Invite(c, S, A) ]
  --[ Vouched(c, t), GainStanding(c, 'all', t, t), VouchOnce(c, t), UsesLive(c, t) ]->
    [ !VouchedFor(c, t), !Standing(c, 'all', t, t) ]
#endif

#ifdef INVITERS
restriction VouchOnlyOnFirstUse:
  "All c A pt pet #v. Vouched(c, <A, pt, pet>) @ v ==>
     Ex #f. AcceptFirstUse(c, A, <A, pt, pet>) @ f & f < v"

restriction VouchOnce:
  "All c t #i #j. VouchOnce(c, t) @ i & VouchOnce(c, t) @ j ==> #i = #j"
#endif

#ifdef INVITERS & not REINVITE
// An invite counts only if it admits the account: no account's invite
// follows the account's admission to the space, so a vouch is never carried
// into a space where the account was already a member.
restriction InviteAdmits:
  "All S A X #i #j. AdmittedBy(S, A, X) @ i & Admitted(S, A) @ j & j < i ==> F"
#endif

#ifdef INVITERS & not UNSCOPED
// A later invite authorizes, in its space, the bindings already vouched for
// when it is made. An invite's record never extends to a binding vouched
// for after it (restriction InviteAfterVouch).
rule AuthorizeVouched:
    let t = <A, pt, pet> in
    [ !VouchedFor(c, t), !Invite(c, S, A) ]
  --[ Authorized(c, S, t), AuthorizedLater(c, S, t), GainStanding(c, S, t, t) ]->
    [ !Standing(c, S, t, t) ]
#endif

#ifdef INVITERS & not UNSCOPED & not RETRO
// The admission behind a later authorization follows the vouch.
restriction InviteAfterVouch:
  "All c S A pt pet #x. AuthorizedLater(c, S, <A, pt, pet>) @ x ==>
     Ex X #v #a. Vouched(c, <A, pt, pet>) @ v & AdmittedBy(S, A, X) @ a & v < a"
#endif

#ifdef INVITERS
// The first-contact hold: every binding accepted by first use or approval
// starts one on acceptance (one accepted by HoldComplete has standing
// already). Time is abstracted as for re-enrollment. A revoked binding
// neither starts nor completes one (RevokedNotUsed), but keeps standing it
// earned before.
rule FirstContactHoldDone:
    let t = <A, pt, pet> in
    [ !Acc(c, t) ]
  --[ FirstContactHoldDone(c, t), UsesLive(c, t), GainStanding(c, 'all', t, t) ]->
    [ !Standing(c, 'all', t, t) ]

// An approved binding inherits its signer's standing, its scope, and its
// root, whether or not the signer has since been revoked. (Roots are
// bindings, written as such so proofs see their shape.)
rule InheritStanding:
    let sg = <A, ps, pes>
        t  = <A, pt, pet>
    in
    [ !ApprovedBy(c, sg, t), !Standing(c, sc, sg, <RA, rp, rpe>) ]
  --[ GainStanding(c, sc, t, <RA, rp, rpe>) ]->
    [ !Standing(c, sc, t, <RA, rp, rpe>) ]

/* ---- Grants ----------------------------------------------------------- */

// An issuer grants a key it holds to a binding it accepted and that is live,
// for members of the space, only if the binding has grant standing for it
// in this space (the restriction below, kept out of the premises so the
// grant's sources stay as in the base model). HPKE is abstracted as
// public-key encryption of the key bound to the header; the issuer
// signature is required.
rule IssueGrant:
    let me  = <A, pk(sk), pk(ek)>
        t   = <B, pr, per>
        hdr = <'hdr', S, kid, t, me>
        ct  = aenc(<k, hdr>, per)
    in
    [ !Dev(A, sk, ek), !Holds(pk(sk), S, k), !Config(S, kid, cm), !Member(S, A), !Member(S, B),
      !Acc(pk(sk), t) ]
  --[ Grant(pk(sk), S, k, t), UsesLive(pk(sk), t), NeedsStanding(pk(sk), S, t) ]->
    [ Out(<hdr, ct, sign(<'grant', hdr, ct>, sk)>) ]

restriction GrantNeedsStanding:
  "All c S t #g. NeedsStanding(c, S, t) @ g ==>
       (Ex RA rp rpe #a. GainStanding(c, S, t, <RA, rp, rpe>) @ a & a < g)
     | (Ex RA rp rpe #a. GainStanding(c, 'all', t, <RA, rp, rpe>) @ a & a < g)"
#else
/* ---- Grants ----------------------------------------------------------- */

// An issuer grants a key it holds to a binding it accepted and that is live,
// for members of the space. HPKE is abstracted as public-key encryption of
// the key bound to the header; the issuer signature is required.
rule IssueGrant:
    let me  = <A, pk(sk), pk(ek)>
        t   = <B, pr, per>
        hdr = <'hdr', S, kid, t, me>
        ct  = aenc(<k, hdr>, per)
    in
    [ !Dev(A, sk, ek), !Holds(pk(sk), S, k), !Config(S, kid, cm), !Member(S, A), !Member(S, B),
      !Acc(pk(sk), t) ]
  --[ Grant(pk(sk), S, k, t), UsesLive(pk(sk), t) ]->
    [ Out(<hdr, ct, sign(<'grant', hdr, ct>, sk)>) ]
#endif

// The recipient checks the signature, that it is the recipient, decryption,
// the commitment, that it accepts the issuer, and membership (A1-A6).
rule AcceptGrant:
    let me  = <B, pk(sk), pk(ek)>
        i   = <A, ps, pes>
        hdr = <'hdr', S, kid, me, i>
    in
    [ !Dev(B, sk, ek), In(<hdr, aenc(<k, hdr>, pk(ek)), sig>), !Config(S, kid, h(<S, kid, k>)),
      !Member(S, A), !Member(S, B), !Acc(pk(sk), i) ]
  --[ Eq(verify(sig, <'grant', hdr, aenc(<k, hdr>, pk(ek))>, ps), true), AcceptKey(me, S, k, ps), UsesLive(pk(sk), i) ]->
    [ !Holds(pk(sk), S, k) ]

/* ---- Restrictions ----------------------------------------------------- */

restriction Equality:
  "All x y #i. Eq(x, y) @ i ==> x = y"

restriction Inequality:
  "All x #i. Neq(x, x) @ i ==> F"

// First use happens once, and never for an account the client already knew.
restriction FirstUseOnlyOnce:
  "All c A #i #j. FirstUse(c, A) @ i & Knew(c, A) @ j & j < i ==> F"

// A revoked binding is never accepted again, nor used for a grant.
restriction RevokedStaysRevoked:
  "All c A t #i #j. Revoke(c, t) @ i & Accept(c, A, t) @ j & i < j ==> F"

restriction RevokedNotUsed:
  "All c t #i #j. Revoke(c, t) @ i & UsesLive(c, t) @ j & i < j ==> F"

// Each binding is accepted, and revoked, at most once per client, so the
// live count counts bindings.
restriction AcceptOnce:
  "All c A B t #i #j. Accept(c, A, t) @ i & Accept(c, B, t) @ j ==> #i = #j"

restriction RevokeOnce:
  "All c t #i #j. Revoke(c, t) @ i & Revoke(c, t) @ j ==> #i = #j"

/* ---- Lemmas ----------------------------------------------------------- */

// 1. An honest member's device receives the key from an honest creator,
// with both sides meeting on first contact. (The negated clauses only prune
// the search for a witness.)
lemma executable_grant:
  exists-trace
  "Ex r S k ps #i. AcceptKey(r, S, k, ps) @ i
     & not (Ex x #c. Compromised(x) @ c)
     & not (Ex a b x y #c. ApprovalAccept(a, b, x, y) @ c)
     & not (Ex a b x #c. HoldStart(a, b, x) @ c)
     & not (Ex a x #c. Revoke(a, x) @ c)"

// 1b. A client accepts a second device of an account through a genuine
// approval by the first, so the approval lemmas are not vacuous.
lemma executable_approval:
  exists-trace
  "Ex c A ps pes pt pet #f #x #a.
       AcceptFirstUse(c, A, <A, ps, pes>) @ f
     & Approved(ps, <A, pt, pet>) @ x
     & ApprovalAccept(c, A, ps, <A, pt, pet>) @ a
     & not (Ex x1 #x2. Compromised(x1) @ x2)
     & not (Ex a1 b1 x1 #x2. HoldStart(a1, b1, x1) @ x2)
     & not (Ex a1 x1 #x2. Revoke(a1, x1) @ x2)"

// 1c. End to end: that device then receives the key from the same client.
lemma executable_approved_device:
  exists-trace
  "Ex c A ps pes pt pet S k IA ce #f #x #a #h #g.
       AcceptFirstUse(c, A, <A, ps, pes>) @ f
     & Approved(ps, <A, pt, pet>) @ x
     & ApprovalAccept(c, A, ps, <A, pt, pet>) @ a
     & AcceptFirstUse(pt, IA, <IA, c, ce>) @ h
     & AcceptKey(<A, pt, pet>, S, k, c) @ g
     & (All c2 A2 x2 t2 #y. ApprovalAccept(c2, A2, x2, t2) @ y ==> #y = #a)
     & (All c2 A2 t2 #y. AcceptFirstUse(c2, A2, t2) @ y ==> (#y = #f | #y = #h))
     & (All r2 S2 k2 i2 #y. AcceptKey(r2, S2, k2, i2) @ y ==> #y = #g)
     & not (Ex x1 #x2. Compromised(x1) @ x2)
     & not (Ex a1 b1 x1 #x2. HoldStart(a1, b1, x1) @ x2)
     & not (Ex a1 x1 #x2. Revoke(a1, x1) @ x2)"

// 4. Every accepted key is the key the creator committed to.
lemma key_agreement:
  "All r S k ps #i. AcceptKey(r, S, k, ps) @ i ==> Ex #j. SpaceKey(S, k) @ j"

// 3. An accepted grant was issued by its issuer for this recipient, unless
// the issuer's signing key is compromised or the adversary's own.
lemma grant_authentication:
  "All r S k ps #i. AcceptKey(r, S, k, ps) @ i ==>
       (Ex #j. Grant(ps, S, k, r) @ j & j < i)
     | (Ex #c. Compromised(ps) @ c & c < i)
     | not (Ex #h. HonestSign(ps) @ h)"

// 5. An approval signed by an honest device was really made by it, unless
// its key is compromised; key-request signatures never stand in for one.
lemma approval_authenticity:
  "All c A ps t #i #h. ApprovalAccept(c, A, ps, t) @ i & HonestSign(ps) @ h ==>
       (Ex #a. Approved(ps, t) @ a & a < i)
     | (Ex #r. Compromised(ps) @ r & r < i)"

// 6. After first contact, a device the adversary created is accepted only
// after a hold, or through an approval by a compromised or adversary key.
lemma no_silent_addition:
  "All c A pt pet #i #j. Accept(c, A, <A, pt, pet>) @ i & Knew(c, A) @ j & j < i
       & not (Ex #h. HonestSign(pt) @ h) ==>
       HoldDone(c, A, <A, pt, pet>) @ i
     | (Ex ps. ApprovalAccept(c, A, ps, <A, pt, pet>) @ i
          & ((not (Ex #h. HonestSign(ps) @ h)) | (Ex #r. Compromised(ps) @ r & r < i)))"

// 7. While every accepted binding of an account is revoked, only a completed
// hold accepts anything. Falsified with -D=NOLIVEGUARD.
lemma reset_acceptance_needs_hold:
  "All c A t #i. AcceptWhileReset(c, A, t) @ i ==> HoldDone(c, A, t) @ i"

#ifdef NOLIVEGUARD
// 7b. Without the live-binding rule, the analysis finds the bypass fixed in
// commit 60edc67: after every accepted binding of an account is revoked, an
// approval signed by a revoked key accepts a new device with no hold.
lemma revoked_signer_bypass:
  exists-trace
  "Ex c A ps pes t #f #r #a.
       AcceptFirstUse(c, A, <A, ps, pes>) @ f
     & Revoke(c, <A, ps, pes>) @ r
     & ApprovalAccept(c, A, ps, t) @ a & AcceptWhileReset(c, A, t) @ a
     & (All c2 A2 x2 t2 #y. ApprovalAccept(c2, A2, x2, t2) @ y ==> #y = #a)
     & not (Ex x1 x2 x3 #x4. HoldStart(x1, x2, x3) @ x4)"
#endif

// 2. Space-key secrecy, proved in two halves whose conjunction is the full
// claim: the adversary learns a space key only from a compromised holder, a
// grant to a compromised encryption key, or a grant to its own key that the
// issuer accepted by first use, after a hold, or through an approval by a
// compromised or adversary signing key. As one lemma the search does not
// terminate; 2a and 2b each do.

// 2a. How a space key can leak: from a compromised holder, or through a
// grant to an encryption key the adversary can decrypt.
lemma key_leaks_only_via_holders_or_grants:
  "All S k #i #j. SpaceKey(S, k) @ i & K(k) @ j ==>
       (Ex #l. LeakHeld(S, k) @ l)
     | (Ex iss B pr pe #g #r. Grant(iss, S, k, <B, pr, pe>) @ g & CompromisedEnc(pe) @ r)
     | (Ex iss B pr pe #g. Grant(iss, S, k, <B, pr, pe>) @ g & not (Ex #h. HonestEnc(pe) @ h))"

// 2b. Why an issuer grants to an encryption key the adversary created: it
// accepted that binding by first use, after a hold, or through an approval
// by a compromised or adversary signing key.
lemma adversary_grant_targets_justified:
  "All iss S k B pr pe #g. Grant(iss, S, k, <B, pr, pe>) @ g & not (Ex #h. HonestEnc(pe) @ h) ==>
       (Ex #a. AcceptFirstUse(iss, B, <B, pr, pe>) @ a)
     | (Ex #a. HoldDone(iss, B, <B, pr, pe>) @ a)
     | (Ex ps #a. ApprovalAccept(iss, B, ps, <B, pr, pe>) @ a
          & ((not (Ex #h. HonestSign(ps) @ h)) | (Ex #r. Compromised(ps) @ r)))"

// 8. Non-goal 1 is a real attack, not an omission: first-use substitution
// discloses a space key with no compromise at all.
lemma first_contact_substitution:
  exists-trace
  "Ex S k iss B pr pe #i #j #a. SpaceKey(S, k) @ i & K(k) @ j
     & AcceptFirstUse(iss, B, <B, pr, pe>) @ a & not (Ex #h. HonestEnc(pe) @ h)
     & not (Ex x #c. Compromised(x) @ c)
     & not (Ex a b x y #c. ApprovalAccept(a, b, x, y) @ c)
     & not (Ex a b x #c. HoldStart(a, b, x) @ c)
     & not (Ex a x #c. Revoke(a, x) @ c)"

/* ---- Lemmas for the inviters proposal (-D=INVITERS) ------------------- */

#ifdef INVITERS & not UNSCOPED
// I1. A grant on a vouch alone: the inviter grants the key of a space its
// account invited the account to, with no hold and no compromise.
lemma inviters_executable_vouched_grant:
  exists-trace
  "Ex iss S k B pr pe #v #g #a. Vouched(iss, <B, pr, pe>) @ v & Authorized(iss, S, <B, pr, pe>) @ v
     & Grant(iss, S, k, <B, pr, pe>) @ g & AcceptKey(<B, pr, pe>, S, k, iss) @ a
     & (All x y #c. Vouched(x, y) @ c ==> #c = #v)
     & (All a b c d #c. Grant(a, b, c, d) @ c ==> #c = #g)
     & not (Ex x #c. Compromised(x) @ c)
     & not (Ex x y #c. FirstContactHoldDone(x, y) @ c)
     & not (Ex a b x y #c. ApprovalAccept(a, b, x, y) @ c)
     & not (Ex a b x #c. HoldStart(a, b, x) @ c)
     & not (Ex a x #c. Revoke(a, x) @ c)"

// I2. A grant on a captured pending invite: the inviter's account invited
// the account before the inviter knew it, and the inviter then vouched for
// its first device.
lemma inviters_executable_captured_grant:
  exists-trace
  "Ex iss S k B X pt pet #x #p #f #g #a. Vouched(iss, <B, pt, pet>) @ x & Authorized(iss, S, <B, pt, pet>) @ x
     & AdmittedBy(S, B, X) @ p & AcceptFirstUse(iss, B, <B, pt, pet>) @ f & p < f
     & Grant(iss, S, k, <B, pt, pet>) @ g & AcceptKey(<B, pt, pet>, S, k, iss) @ a
     & (All x y #c. Vouched(x, y) @ c ==> #c = #x)
     & (All a b c d #c. Grant(a, b, c, d) @ c ==> #c = #g)
     & not (Ex x #c. Compromised(x) @ c)
     & not (Ex x y #c. FirstContactHoldDone(x, y) @ c)
     & not (Ex a b x y #c. ApprovalAccept(a, b, x, y) @ c)
     & not (Ex a b x #c. HoldStart(a, b, x) @ c)
     & not (Ex a x #c. Revoke(a, x) @ c)"

// I3. A grant after a first-contact hold, with no vouch anywhere.
lemma inviters_executable_held_grant:
  exists-trace
  "Ex iss S k r #h #g #a. FirstContactHoldDone(iss, r) @ h & Grant(iss, S, k, r) @ g & AcceptKey(r, S, k, iss) @ a
     & (All x y #c. FirstContactHoldDone(x, y) @ c ==> #c = #h)
     & (All a b c d #c. Grant(a, b, c, d) @ c ==> #c = #g)
     & not (Ex x y #c. Vouched(x, y) @ c)
     & not (Ex x #c. Compromised(x) @ c)
     & not (Ex a b x y #c. ApprovalAccept(a, b, x, y) @ c)
     & not (Ex a b x #c. HoldStart(a, b, x) @ c)
     & not (Ex a x #c. Revoke(a, x) @ c)"

// I4. Under the inviters rule, first use alone no longer justifies a grant
// to an encryption key the adversary created. The issuer vouched for that
// binding and an invite of the binding's account to this space authorized
// it, no earlier than the vouch,
// completed a first-contact or re-enrollment hold on it, or accepted it
// through an approval by a compromised or adversary signing key. With 2a,
// which still verifies under the variant, this is space-key secrecy for it.
lemma inviters_grant_targets_justified:
  "All iss S k B pr pe #g. Grant(iss, S, k, <B, pr, pe>) @ g & not (Ex #h. HonestEnc(pe) @ h) ==>
       (Ex #v #a. Vouched(iss, <B, pr, pe>) @ v & Authorized(iss, S, <B, pr, pe>) @ a & not (a < v))
     | (Ex #a. FirstContactHoldDone(iss, <B, pr, pe>) @ a)
     | (Ex #a. HoldDone(iss, B, <B, pr, pe>) @ a)
     | (Ex ps #a. ApprovalAccept(iss, B, ps, <B, pr, pe>) @ a
          & ((not (Ex #h. HonestSign(ps) @ h)) | (Ex #r. Compromised(ps) @ r)))"
#endif

#ifdef INVITERS & UNSCOPED
// I5. With vouches that count in every space, an adversary binding vouched
// for through an invite to one space is granted the key of another space
// its account was never invited to by the issuer, with no hold and no
// compromise: the attack that made vouches space-scoped. (The grant is to
// an encryption key the adversary created, so it discloses the key: 2a.)
lemma cross_space_vouch_attack:
  exists-trace
  "Ex iss S1 S2 k B pr pe #v #i #g.
       Vouched(iss, <B, pr, pe>) @ v & Invited(iss, S1, B) @ i & Grant(iss, S2, k, <B, pr, pe>) @ g
     & not (S1 = S2)
     & not (Ex #h. HonestEnc(pe) @ h)
     & not (Ex x #j. Invited(x, S2, B) @ j)
     & (All x y #c. Vouched(x, y) @ c ==> #c = #v)
     & (All a b c d #c. Grant(a, b, c, d) @ c ==> #c = #g)
     & not (Ex x #c. Compromised(x) @ c)
     & not (Ex x y #c. FirstContactHoldDone(x, y) @ c)
     & not (Ex a b x y #c. ApprovalAccept(a, b, x, y) @ c)
     & not (Ex a b x #c. HoldStart(a, b, x) @ c)
     & not (Ex a x #c. Revoke(a, x) @ c)"
#endif

#ifdef INVITERS & REINVITE & not UNSCOPED
// I6. Without InviteAdmits, an invite of an account already admitted to a
// space carries the inviter's vouch there: the client gains standing in a
// space where another admission had made the account a member first.
lemma reinvite_carries_vouch:
  exists-trace
  "Ex c S B X Y pt pet r #a #i #k #g. AdmittedBy(S, B, Y) @ a & AdmittedBy(S, B, X) @ i & a < i
     & not (X = Y) & Invited(c, S, B) @ k & GainStanding(c, S, <B, pt, pet>, r) @ g
     & (All Z #j. AdmittedBy(S, B, Z) @ j ==> (#j = #a | #j = #i))
     & not (Ex x y #c. FirstContactHoldDone(x, y) @ c)
     & not (Ex a b x y #c. ApprovalAccept(a, b, x, y) @ c)
     & not (Ex a b x #c. HoldStart(a, b, x) @ c)
     & not (Ex x #c. Compromised(x) @ c)"
#endif

#ifdef INVITERS & RETRO & not UNSCOPED
// I7. If a later vouch could combine with an earlier invite, an invite
// made before the client knew the account, and never captured, would let a
// vouch made through another space's invite authorize it after the fact:
// the client grants that space's key to the adversary's binding with no
// hold and no compromise.
lemma retro_vouch_attack:
  exists-trace
  "Ex c S S2 B X pt pet k #a #f #v #g.
       AdmittedBy(S, B, X) @ a & AcceptFirstUse(c, B, <B, pt, pet>) @ f & a < f
     & Vouched(c, <B, pt, pet>) @ v & Authorized(c, S2, <B, pt, pet>) @ v & not (S2 = S)
     & Grant(c, S, k, <B, pt, pet>) @ g
     & not (Ex #h. HonestEnc(pet) @ h)
     & (All Y #j. AdmittedBy(S, B, Y) @ j ==> #j = #a)
     & (All a b c d #c. Grant(a, b, c, d) @ c ==> #c = #g)
     & not (Ex x #c. Compromised(x) @ c)
     & not (Ex x y #c. FirstContactHoldDone(x, y) @ c)
     & not (Ex a b x y #c. ApprovalAccept(a, b, x, y) @ c)
     & not (Ex a b x #c. HoldStart(a, b, x) @ c)
     & not (Ex a x #c. Revoke(a, x) @ c)"
#endif

#ifdef INVITERS & not UNSCOPED & not REINVITE & not RETRO
// I8a. Standing's root is the binding itself or an approval ancestor: an
// inherited standing comes from the standing of the binding that approved
// it, with the same root.
lemma inviters_root_is_ancestor:
  "All c sc B pt pet r #i. GainStanding(c, sc, <B, pt, pet>, r) @ i ==>
       r = <B, pt, pet>
     | (Ex ps pes #j #k. ApprovalAccept(c, B, ps, <B, pt, pet>) @ j
          & GainStanding(c, sc, <B, ps, pes>, r) @ k & k < i)"

// I8b. Scope is preserved through approval chains, whoever signed them.
// Standing in a space goes back to its root's authorization in that space,
// by the vouch itself or by an invite admitting the account after the
// vouch; standing in every space goes back to a completed first-contact or
// re-enrollment hold on its root.
lemma inviters_standing_scoped [reuse, use_induction]:
  "All c sc t B pr per #i. GainStanding(c, sc, t, <B, pr, per>) @ i ==>
       (Ex #v. Vouched(c, <B, pr, per>) @ v & Authorized(c, sc, <B, pr, per>) @ v)
     | (Ex X #v #a #x. Vouched(c, <B, pr, per>) @ v & AdmittedBy(sc, B, X) @ a & v < a
          & Authorized(c, sc, <B, pr, per>) @ x)
     | (sc = 'all' & (Ex #h. FirstContactHoldDone(c, <B, pr, per>) @ h))
     | (sc = 'all' & (Ex #h. HoldDone(c, B, <B, pr, per>) @ h))"

// I8c. So every grant, to any binding, rests on standing whose root (by
// I8a, the binding or an approval ancestor) was authorized in that space no
// earlier than its vouch, or completed a hold.
lemma inviters_grant_scope:
  "All iss S k t #g. Grant(iss, S, k, t) @ g ==>
       (Ex B pr per #s #v. GainStanding(iss, S, t, <B, pr, per>) @ s
          & Vouched(iss, <B, pr, per>) @ v & Authorized(iss, S, <B, pr, per>) @ v)
     | (Ex B pr per X #s #v #a #x. GainStanding(iss, S, t, <B, pr, per>) @ s
          & Vouched(iss, <B, pr, per>) @ v & AdmittedBy(S, B, X) @ a & v < a
          & Authorized(iss, S, <B, pr, per>) @ x)
     | (Ex B pr per #s #h. GainStanding(iss, 'all', t, <B, pr, per>) @ s
          & FirstContactHoldDone(iss, <B, pr, per>) @ h)
     | (Ex B pr per #s #h. GainStanding(iss, 'all', t, <B, pr, per>) @ s
          & HoldDone(iss, B, <B, pr, per>) @ h)"
#endif

end
